# Apple App Store Connect Webhook Receiver Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
NODE_ENV=production
PORT=3001

# Apple App Store Connect Webhook Configuration
APP_STORE_WEBHOOK_SECRET=your-webhook-secret-here

# App Store Server API Configuration (for test notifications)
APP_STORE_SERVER_API_KEY_ID=your-key-id-here
APP_STORE_SERVER_API_ISSUER_ID=your-issuer-id-here
APP_STORE_SERVER_API_PRIVATE_KEY_PATH=/opt/webhook-receiver/AuthKey_XXXXXXXXXX.p8
APP_STORE_BUNDLE_ID=com.yourcompany.yourapp

# Domain Configuration
WEBHOOK_DOMAIN=webhook.yourdomain.com

# SSL/Email Configuration (for Let's Encrypt)
ADMIN_EMAIL=admin@yourdomain.com

# Firestore Configuration
GOOGLE_APPLICATION_CREDENTIALS=/opt/webhook-receiver/service-account-key.json
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_ENABLED=true

# Optional: Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=false 